{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": true,
    "builder": {
      "type": "webpack",
      "options": {
        "outputPath": "dist"
      }
    },
    "assets": [
      {
        "include": "**/*.{graphql,gql,json,proto,ejs,hbs}",
        "outDir": "dist"
      }
    ],
    "watchAssets": true
  }
}
